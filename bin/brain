        opt("--open", action="store_true", help="open it in the browser"),
        opt("--json", action="store_true", help="print the state once, as JSON"))
    cmd("stale", cmd_stale, "freshness check: is <id>'s status.md behind a time the host gave (e.g. a thread's "
        "updatedAt, in UTC)?", "id", "host_time", opt("--grace", type=int, default=5, help="minutes allowed"))
    cmd("jobs", cmd_jobs, "jobs per node: open ones and their age, median hours and review rounds, causes",
        opt("id", nargs="?"), opt("--branch"), opt("--lessons", help="learned item ids, or none: <reason>"),
        opt("--switch", help="record provider switch: old -> new: reason"),
        opt("--start", action="store_true", help="coordinator: start an import:<snapshot> study"),
        opt("--close", action="store_true", help="coordinator: close a processed import study"))
    cmd("due", cmd_due, "coordinator actions from files and local git; empty means no output",
        opt("id", nargs="?"), opt("--json", action="store_true"),
        opt("--quiet", action="store_true", help="no output; exit 1 when anything is due, 0 otherwise"))
    cmd("inbox", cmd_inbox, "needs in a node's subtree (default: calling node); --new remembers per reporter",
        opt("id", nargs="?"), opt("--json", action="store_true"), opt("--new", action="store_true"))
    cmd("handback", cmd_handback, "worker signal and optional inbox need for one open ledger job",
        "id", opt("--branch", required=True), opt("--state", choices=["done", "failed", "blocked", "question"], required=True),
        opt("--report"), opt("--lessons", help="proposed lessons, or none: <reason>"),
