#!/usr/bin/env python3
"""brain: mechanics for a Brain instance (see core/MODEL.md)."""
import fcntl
import os
import sys
from pathlib import Path

# Keep module imports read-only in installed core checkouts on every Python.
sys.dont_write_bytecode = True


def _pinned_lib(core):
    """An instance's staged core runs its current installed release (lib/brain/core_releases.py).

    Resolve .brain/core-current once and hold a shared flock on that release's pin for this
    process's life: a later swap never changes what this process imports, and prune skips it.
    """
    link = core.parent / ".brain" / "core-current"
    release = core
    if core.name == "core" and link.is_symlink():
        release = None
        for _ in range(3):  # a prune racing this start removes a release only after two swaps
            try:
                candidate = link.resolve(strict=True)
                pin = os.open(str(candidate) + ".pin", os.O_RDONLY)
            except OSError:
                continue
            fcntl.flock(pin, fcntl.LOCK_SH)
            if (candidate / "lib" / "brain").is_dir():
                release = candidate
                break
            os.close(pin)
        if release is None:
            print("brain: installed core release unavailable; running the staged core", file=sys.stderr)
            return core / "lib", None
    else:
        try:  # a release started by its own path pins itself too
            pin = os.open(str(core) + ".pin", os.O_RDONLY)
        except OSError:
            return core / "lib", None
        fcntl.flock(pin, fcntl.LOCK_SH)
    return release / "lib", pin


# Resolve symlinked installed commands before finding this checkout's modules.
_LIB, _PIN = _pinned_lib(Path(__file__).resolve().parent.parent)
sys.path.insert(0, str(_LIB))

from brain.cli import main


if __name__ == "__main__":
    main()
