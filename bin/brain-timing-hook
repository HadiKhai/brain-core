#!/usr/bin/env python3
"""Optional Pre/PostToolUse timing hook. Shipped only; never installed by brain link."""
import sys
import contextlib
import io
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / 'lib'))
with contextlib.redirect_stderr(io.StringIO()):
    try:
        from brain.operation_timings import hook_main
        hook_main()
    except (Exception, SystemExit):
        pass
