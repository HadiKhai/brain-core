# Read by core/bin/brain. Paths are relative to a node folder (instructions) or the instance root (skills).
INSTRUCTIONS_LINK=CLAUDE.md
SKILLS_DIR=.claude/skills
GLOBAL_INSTRUCTIONS=~/.claude/CLAUDE.md
GLOBAL_HOME_ENV=CLAUDE_CONFIG_DIR
GLOBAL_HOME_DEFAULT=~/.claude
# Stop hook: a settings file in every node folder (Claude reads only the working folder's)
HOOKS_LINK=.claude/settings.json
HOOKS_SCOPE=node
HOOKS_SOURCE=claude-hooks.json
